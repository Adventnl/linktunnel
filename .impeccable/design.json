      "css": ".ds-card{padding:12px;border:1px solid var(--border);border-radius:8px;color:var(--text);font:14px/20px var(--font-sans);}.ds-card strong{font-weight:500;}.ds-card label{display:flex;align-items:center;gap:8px;margin-top:8px;font-size:12px;color:var(--muted);}.ds-card input:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}"
    }
