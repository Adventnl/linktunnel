      "css": ".ds-button-secondary{font-family:var(--font-sans);font-size:14px;font-weight:500;line-height:20px;display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:6px 12px;border-radius:8px;cursor:pointer;transition:color .15s,background-color .15s,border-color .15s;background:var(--panel-2);color:var(--text);border:1px solid var(--border);}.ds-button-secondary:hover{border-color:var(--accent);}.ds-button-secondary:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}.ds-button-secondary:disabled{opacity:.4;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none;}}"
