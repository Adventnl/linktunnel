      "name": "Selected Device",
      "kind": "nav",
      "refersTo": "device-selection",
      "description": "Selected navigation row from DeviceSidebar.tsx; the live app measures and glides a shared plate behind this content.",
      "html": "<button class=\"ds-device\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M8 21h8M12 17v4\"/></svg><span class=\"ds-device-copy\"><strong>Living room PC</strong><span>Online</span></span></button>",
      "css": ".ds-device{display:flex;align-items:center;gap:13px;width:100%;padding:13px 8px 13px 12px;text-align:left;background:var(--selection);color:var(--accent);border:0;border-radius:11px;box-shadow:inset 0 1px var(--glass-highlight),0 2px 5px rgb(21 68 108 / .05);font-family:var(--font-sans);cursor:pointer;}.ds-device-copy{display:flex;flex-direction:column;gap:4px;}.ds-device-copy strong{font-size:12px;font-weight:600;color:var(--text);}.ds-device-copy span{font-size:11px;color:var(--muted);}.ds-device:hover{box-shadow:inset 0 1px var(--glass-highlight);}.ds-device:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}"
    },
