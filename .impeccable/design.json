  "narrative": {
    "northStar": "Liquid Glass",
    "overview": "Frosted slate navigation frames a clear working surface. Soft highlights, restrained ocean blue and compact native controls make the app feel like one connected workspace. Glass has a structural role around the work; readable desktop and terminal content remain the center of attention.\n\nThe system uses native UI typography, rounded controls and consistent line icons. Light glass is the confirmed default; dark and system appearances preserve the same hierarchy and material relationships. This records the shipped implementation, rather than a separate mockup.",
    "keyCharacteristics": [
      "Translucent navigation and floating controls around an opaque working surface.",
      "Compact labels, generous selected-device space and restrained blue selection.",
      "A moving selection plate with a brief settling transition for the workspace.",
      "Theme-aware controls and terminal output, with reduced motion and transparency support."
    ],
    "rules": [
      {
        "name": "The Appearance Parity Rule",
        "body": "Apply semantic roles in both appearances; terminal output must refresh with explicit theme changes and system appearance changes.",
        "section": "colors"
      },
      {
        "name": "The Native Control Rule",
        "body": "Keep application labels in the native UI stack and terminal content in monospace; use the shared SVG icon set for actions.",
        "section": "typography"
      },
      {
        "name": "The Clear Work Rule",
        "body": "Keep glass in navigation and floating controls; keep the working surface legible and opaque.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do apply the Appearance Parity Rule to controls, floating surfaces and terminal output.",
      "Do keep the working surface opaque under the Clear Work Rule.",
      "Do reuse native UI type, the shared line icons and visible keyboard focus.",
      "Do retain the horizontal device strip and accessible utilities at narrow widths.",
      "Do honor reduced motion, reduced transparency and forced-color focus preferences."
    ],
    "donts": [
      "Don't replace semantic theme roles with fixed light colors on new controls.",
      "Don't obscure the working content with decorative glass layers.",
      "Don't use text glyphs as substitutes for the shared action icons.",
      "Don't remove status text in favor of color alone."
    ]
  }
}
