      "html": "<label class=\"ds-field-label\">Appearance<select class=\"ds-field\"><option>Light</option><option>Dark</option><option>System</option></select></label>",
      "css": ".ds-field-label{display:block;font:14px/20px var(--font-sans);color:var(--muted);}.ds-field{display:block;width:100%;margin-top:4px;border:1px solid var(--border);border-radius:8px;background:var(--panel-2);color:var(--text);padding:6px 8px;font:inherit;}.ds-field:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}"
