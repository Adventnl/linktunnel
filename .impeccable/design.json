  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared primary action from Modal.tsx; appearance follows inherited semantic variables.",
      "html": "<button class=\"ds-button-primary\">Connect</button>",
      "css": ".ds-button-primary{font-family:var(--font-sans);font-size:14px;font-weight:500;line-height:20px;display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:6px 12px;border-radius:8px;cursor:pointer;transition:color .15s,background-color .15s,border-color .15s;background:var(--accent);color:var(--accent-text);border:0;}.ds-button-primary:hover{filter:brightness(1.1);}.ds-button-primary:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}.ds-button-primary:disabled{opacity:.4;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
    },
    {
      "name": "Secondary Button",
