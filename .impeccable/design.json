  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Compact shared action.",
      "html": "<button class=\"ds-primary\">Connect</button>",
      "css": ".ds-primary{background:var(--accent);color:var(--accent-text);border:0;border-radius:8px;padding:6px 12px;font:500 14px system-ui;cursor:pointer}.ds-primary:hover{filter:brightness(1.1)}.ds-primary:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Compact shared action.",
      "html": "<button class=\"ds-secondary\">Connect</button>",
      "css": ".ds-secondary{background:var(--panel-2);color:var(--text);border:0;border-radius:8px;padding:6px 12px;font:500 14px system-ui;cursor:pointer}.ds-secondary:hover{filter:brightness(1.1)}.ds-secondary:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Compact shared action.",
      "html": "<button class=\"ds-ghost\">Connect</button>",
      "css": ".ds-ghost{background:transparent;color:var(--muted);border:0;border-radius:8px;padding:6px 12px;font:500 14px system-ui;cursor:pointer}.ds-ghost:hover{filter:brightness(1.1)}.ds-ghost:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Theme-aware compact select.",
      "html": "<select class=\"ds-field\"><option>Automatic</option><option>Sharper text</option></select>",
      "css": ".ds-field{background:var(--chrome);color:var(--text);border:0;border-radius:10px;padding:8px 12px;font:12px system-ui}.ds-field:hover{background:var(--selection)}.ds-field:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Selection Lens",
      "kind": "nav",
      "refersTo": "device-selection",
      "description": "Selected computer on raised glass.",
      "html": "<button class=\"ds-device\">Home server <span>Online</span></button>",
      "css": ".ds-device{width:220px;text-align:left;padding:17px 13px;border:0;border-radius:16px;background:linear-gradient(130deg,var(--glass-edge),transparent 58%),var(--selection);color:var(--text);box-shadow:inset 0 1px var(--glass-highlight),0 4px 10px var(--glass-shade);font:600 12px system-ui}.ds-device span{display:block;margin-top:6px;font-size:11px;font-weight:400}.ds-device:hover{filter:brightness(1.05)}.ds-device:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Glass Menu",
      "kind": "card",
      "refersTo": "device-menu",
      "description": "Floating compact device actions.",
      "html": "<div class=\"ds-menu\"><button>Connect</button><button>Terminal</button></div>",
      "css": ".ds-menu{width:210px;padding:6px;background:var(--glass);backdrop-filter:blur(36px) saturate(1.5);border-radius:16px;box-shadow:inset 0 1px var(--glass-highlight),var(--shadow)}.ds-menu button{display:block;width:100%;padding:9px 10px;border:0;border-radius:10px;background:transparent;color:var(--text);text-align:left;font:12px system-ui}.ds-menu button:hover{background:var(--selection)}.ds-menu button:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Lockdown Switch",
      "kind": "custom",
      "description": "Accessible lockdown state control.",
      "html": "<button class=\"ds-switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Lockdown mode\"><span></span></button>",
      "css": ".ds-switch{width:42px;height:25px;padding:3px;border:0;border-radius:20px;background:var(--accent);box-shadow:inset 0 1px 3px var(--glass-shade)}.ds-switch span{display:block;width:19px;height:19px;border-radius:50%;background:var(--accent-text);transform:translateX(17px)}.ds-switch:hover{filter:brightness(1.1)}.ds-switch:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "Liquid Glass",
    "overview": "Clear white and smoked dark glass share one continuous ambient field. Background diffusion, translucent fill and thin optical highlights distinguish raised navigation and controls from the open workspace. This replaces the former opaque working panel and utility-heavy shell.\n\nNative UI typography, compact controls and consistent line icons keep connection work readable. Light is the persisted default; dark and automatic appearances use the same material hierarchy. Native macOS vibrancy and Windows acrylic sit beneath the web interface, while remote pixels remain in a native viewer.",
    "keyCharacteristics": [
      "Clear and smoked glass with matching semantic roles.",
      "A floating computer list and quiet session surface, with account and settings in the top bar.",
      "A feathered gradient theme dissolve and a moving selection lens.",
      "Aspect-correct native desktop presentation with readable terminal content."
    ],
    "rules": [
      {
        "name": "The Appearance Parity Rule",
        "body": "Use the matching semantic roles in both appearances; selected dark-row status uses primary text to remain readable over its bright lens.",
        "section": "colors"
      },
      {
        "name": "The Native Content Rule",
        "body": "Keep desktop pixels in the native viewer and terminal content in its monospace surface; glass belongs to the surrounding interface.",
        "section": "elevation"
      },
      {
        "name": "The Accessible Motion Rule",
        "body": "Honor reduced motion, reduced transparency and forced-color preferences rather than requiring the material effect to understand state.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use semantic theme roles for every control and floating surface.",
      "Do keep status text beside state dots and preserve visible keyboard focus.",
      "Do keep session controls with the active session and preserve remote proportions.",
      "Do label synthetic browser preview data visibly at every supported width."
    ],
    "donts": [
      "Don't restore the phone, command-search, CLI or local-computer utility footer to this desktop shell.",
      "Don't blur the remote desktop picture or make glass obscure working content.",
      "Don't use glyphs in place of the shared SVG action icons.",
      "Don't animate layout dimensions for the moving selection lens."
    ]
  }
}
