      "description": "Floating device actions from DeviceMenu.tsx and index.css.",
      "html": "<div class=\"ds-menu\"><button>Open terminal</button><button>Wake computer</button><div class=\"ds-menu-separator\"></div><button class=\"ds-menu-danger\">Remove device</button></div>",
      "css": ".ds-menu{width:210px;padding:6px;background:var(--glass);color:var(--text);backdrop-filter:blur(30px) saturate(1.3);border-radius:12px;box-shadow:inset 0 1px var(--glass-highlight),0 12px 42px rgb(16 37 61 / .2);}.ds-menu button{display:flex;align-items:center;width:100%;padding:9px 10px;text-align:left;font:12px var(--font-sans);border:0;border-radius:6px;background:transparent;color:inherit;cursor:pointer;}.ds-menu button:hover,.ds-menu button:focus-visible{background:var(--selection);}.ds-menu button:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}.ds-menu .ds-menu-danger{color:var(--danger);}.ds-menu-separator{height:1px;background:var(--border);margin:5px;}@media(prefers-reduced-transparency:reduce){.ds-menu{background:var(--panel);backdrop-filter:none;}}"
    },
