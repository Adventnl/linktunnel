# Self-hosted signaling server (see docs/SELF_HOSTING.md). Put a TLS terminator in front of it.
[Unit]
Description=linktunnel signaling server
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/nexus-signal --listen 127.0.0.1:8443 --audience signal.example.com
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
