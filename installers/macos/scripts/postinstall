#!/bin/sh
# Creates the unprivileged account for the wake-helper daemon (not started automatically) and
# tells the user what to grant. The per-user agent starts at the next login.
set -e
if ! dscl . -read /Users/_nexus >/dev/null 2>&1; then
  ID=$(dscl . -list /Users UniqueID | awk '{print $2}' | sort -n | awk '$1>=300 && $1<400 {m=$1} END {print m+1}')
  dscl . -create /Users/_nexus
  dscl . -create /Users/_nexus UserShell /usr/bin/false
  dscl . -create /Users/_nexus RealName "Nexus Remote"
  dscl . -create /Users/_nexus UniqueID "$ID"
  dscl . -create /Users/_nexus PrimaryGroupID 20
  dscl . -create /Users/_nexus NFSHomeDirectory /var/empty
fi
mkdir -p /Library/Logs/Nexus && chown _nexus /Library/Logs/Nexus
exit 0
