<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>app.nexus-remote</string>
  <key>CFBundleName</key><string>Nexus Remote</string>
  <key>CFBundleDisplayName</key><string>Nexus Remote</string>
  <key>CFBundleExecutable</key><string>nexus-agent</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@VERSION@</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
  <!-- Shown by macOS when the permission is requested. -->
  <key>NSAudioCaptureUsageDescription</key>
  <string>Nexus Remote streams this Mac's sound to your own devices that you have paired and allowed to listen.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Only used if you explicitly turn on microphone sharing.</string>
  <key>NSScreenCaptureUsageDescription</key>
  <string>Nexus Remote shows this Mac's screen to your own paired devices.</string>
</dict>
</plist>
